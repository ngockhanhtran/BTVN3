@using BTVN3.Models
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<Category>;
    var products = ViewData["productList"] as List<Product>;
}

<div class="row mt-3">
    <!-- Cột danh mục bên trái -->
    <div class="col-md-3">
        <h5 class="fw-bold text-uppercase">DANH MỤC</h5>
        <div class="list-group">
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <a href="@Url.Action("GetAllProduct", "Product", new { categoryId = cat.categoryID })"
                       class="list-group-item list-group-item-action text-secondary">
                        @cat.categoryName
                    </a>
                }
            }
        </div>
    </div>

    <!-- Cột danh sách sản phẩm bên phải -->
    <div class="col-md-9">
        <h3 class="mb-3">Danh sách sản phẩm</h3>
        <div class="row">
            @if (products != null && products.Count > 0)
            {
                foreach (var item in products)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 text-center shadow-sm">
                            <!-- Đường dẫn ảnh lấy từ wwwroot/images/ -->
                            <img src="~/images/@item.image" class="card-img-top p-2" alt="@item.productName" style="height: 220px; object-fit: contain;">
                            <div class="card-body d-flex flex-column justify-content-between p-2">
                                <h6 class="card-title text-start fw-normal fs-6">@item.productName</h6>
                                <p class="card-text text-start mb-2" style="font-size: 0.85rem;">
                                    Giá gốc: <del>@item.oldPrice</del> Giá: <strong>@item.price</strong>
                                </p>
                                <a href="@Url.Action("Detail", "Product", new { id = item.productID })" class="btn btn-success btn-sm w-100">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Không tìm thấy sản phẩm nào trong danh mục này.</p>
            }
        </div>
    </div>
</div>